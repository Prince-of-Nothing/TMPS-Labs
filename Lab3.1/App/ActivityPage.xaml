<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab3.ActivityPage"
             Title="Activity"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid Padding="16,12" RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="2">
                <Label Text="Activity" FontSize="25" FontAttributes="Bold" />
                <Label x:Name="CountLabel" FontSize="12" TextColor="{DynamicResource TextMuted}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Clear" Clicked="OnClearClicked" VerticalOptions="Center"
                    BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
        </Grid>

        <CollectionView Grid.Row="1" x:Name="FeedList" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="6" VerticalOptions="Center">
                    <Label Text="No activity yet" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="Changes you make to the library show up here."
                           FontSize="13" TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource StrokeBg}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="12,8" Margin="0,3">
                        <Label Text="{Binding .}" FontSize="13" LineBreakMode="WordWrap" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
