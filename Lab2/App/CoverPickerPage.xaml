<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Lab2"
             x:Class="Lab2.CoverPickerPage"
             Title="Cover search"
             BackgroundColor="#F4F6F5">

    <Grid Padding="16,12" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="SearchEntry" Placeholder="Search a title..." ReturnType="Search"
                   Completed="OnSearchClicked" />
            <Button Grid.Column="1" Text="Search" Clicked="OnSearchClicked" />
        </Grid>

        <Label Grid.Row="1" x:Name="RouteLabel" FontSize="11" TextColor="#2F6F73" />
        <Label Grid.Row="2" x:Name="StatusLabel" FontSize="12" TextColor="#6E7B85" />

        <CollectionView Grid.Row="3" x:Name="ResultsList" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Search for a cover to see results." FontSize="13"
                       TextColor="#6E7B85" HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:CoverRow">
                    <Border BackgroundColor="#FFFFFF" Stroke="#DFE5E3" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14" Padding="10" Margin="0,4">
                        <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="#E9EEEC" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" HeightRequest="88" WidthRequest="62">
                                <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Provider}" FontSize="11" TextColor="#6E7B85" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Use" Clicked="OnUseClicked"
                                    CommandParameter="{Binding Candidate}" VerticalOptions="Center"
                                    BackgroundColor="#C9DDB8" TextColor="#2E4220" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
