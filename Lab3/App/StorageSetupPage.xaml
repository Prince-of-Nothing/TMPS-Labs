<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab3.StorageSetupPage"
             Title="Library storage"
             BackgroundColor="#F8F6F3">

    <ScrollView Padding="16,12">
        <VerticalStackLayout Spacing="14">
            <Label Text="Where should the library live?" FontSize="25" FontAttributes="Bold" />
            <Label Text="The watchlist is a folder of Markdown files. Choose a location you can open later with a file manager or any text editor."
                   FontSize="13" TextColor="#8A7F8C" />

            <Border BackgroundColor="#FFFFFF" Stroke="#EAE6DF" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Shared Documents" FontSize="16" FontAttributes="Bold" TextColor="#6B5B7A" />
                    <Label Text="Visible in the Files app. Requires Android's “All files access” permission."
                           FontSize="12" TextColor="#8A7F8C" />
                    <Label x:Name="SharedPathLabel" FontSize="11" TextColor="#A0899C"
                           LineBreakMode="WordWrap" />
                    <Label x:Name="PermissionLabel" FontSize="11" FontAttributes="Bold" TextColor="#8C4A63" />
                    <Button Text="Use shared Documents" Clicked="OnSharedClicked" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#FFFFFF" Stroke="#EAE6DF" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="App storage" FontSize="16" FontAttributes="Bold" TextColor="#6B5B7A" />
                    <Label Text="Private to the app, no permission needed. Use Export or the shared folder if you want to open the files outside the app."
                           FontSize="12" TextColor="#8A7F8C" />
                    <Label x:Name="AppPathLabel" FontSize="11" TextColor="#A0899C"
                           LineBreakMode="WordWrap" />
                    <Button Text="Use app storage" Clicked="OnAppClicked"
                            BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="StatusLabel" FontSize="12" TextColor="#A0899C" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
