<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab3.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Ink">#1A1525</Color>
            <Color x:Key="Muted">#8A7F8C</Color>
            <Color x:Key="Plum">#6B5B7A</Color>
            <Color x:Key="Paper">#F8F6F3</Color>
            <Color x:Key="Line">#EAE6DF</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1525, Dark=#F4EEF7}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Plum}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinimumHeightRequest" Value="36" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E1B24}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1525, Dark=#F4EEF7}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E1B24}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1525, Dark=#F4EEF7}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1525, Dark=#F4EEF7}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E1B24}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1525, Dark=#F4EEF7}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
