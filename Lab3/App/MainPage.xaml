<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab3.MainPage"
             Title="Watchlist"
             BackgroundColor="#F8F6F3">

    <Grid Padding="16,12" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="Watchlist" FontSize="28" FontAttributes="Bold" TextColor="#1A1525" />
                <Label x:Name="SubtitleLabel" FontSize="12" TextColor="#8A7F8C" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+ Add" Clicked="OnAddClicked"
                    BackgroundColor="#6B5B7A" TextColor="White" FontAttributes="Bold"
                    CornerRadius="10" Padding="16,8" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" BackgroundColor="#FFFFFF" Stroke="#EAE6DF" StrokeThickness="1"
                StrokeShape="RoundRectangle 16" Padding="14,10">
            <Grid ColumnDefinitions="*,*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="0">
                    <Label x:Name="TotalValue" Text="0" FontSize="20" FontAttributes="Bold" />
                    <Label Text="total" FontSize="11" TextColor="#8A7F8C" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <Label x:Name="PlannedValue" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#6B5B7A" />
                    <Label Text="planned" FontSize="11" TextColor="#8A7F8C" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="0">
                    <Label x:Name="ConsumedValue" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#3F6B46" />
                    <Label Text="consumed" FontSize="11" TextColor="#8A7F8C" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="0">
                    <Label x:Name="RatedValue" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#8C4A63" />
                    <Label Text="rated" FontSize="11" TextColor="#8A7F8C" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Import" Clicked="OnImportClicked" BackgroundColor="#D3B5C4" TextColor="#4A2E3E" />
                <Button Text="Export" Clicked="OnExportClicked" BackgroundColor="#D3B5C4" TextColor="#4A2E3E" />
                <Button x:Name="UndoButton" Text="Undo" Clicked="OnUndoClicked" BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
                <Button x:Name="RedoButton" Text="Redo" Clicked="OnRedoClicked" BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
                <Button Text="Reload" Clicked="OnReloadClicked" BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
                <Button Text="Activity" Clicked="OnActivityClicked" BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="Live stats" FontSize="12" VerticalOptions="Center" TextColor="#6B5B7A" />
                    <Switch x:Name="LiveStatsSwitch" Toggled="OnLiveStatsToggled" OnColor="#6B5B7A" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <Picker x:Name="StatusFilter" Grid.Column="0" Title="Status" SelectedIndexChanged="OnFilterChanged" />
            <Picker x:Name="SortPicker" Grid.Column="1" Title="Sort" SelectedIndexChanged="OnFilterChanged" />
            <Label x:Name="AverageLabel" Grid.Column="2" FontSize="12" TextColor="#8A7F8C" VerticalOptions="Center" />
        </Grid>

        <RefreshView Grid.Row="4" x:Name="Refresh" Refreshing="OnRefreshing">
            <CollectionView x:Name="ItemsList" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="Nothing here yet" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Add an entry, or import your AniList / MAL list."
                               FontSize="13" TextColor="#8A7F8C" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#FFFFFF" Stroke="#EAE6DF" StrokeThickness="1"
                                StrokeShape="RoundRectangle 16" Padding="12" Margin="0,4">
                            <Grid ColumnDefinitions="92,*" ColumnSpacing="12">
                                <Border Grid.Column="0" BackgroundColor="#F1EDE7" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10" HeightRequest="132" WidthRequest="92">
                                    <Image Source="{Binding Cover}" Aspect="AspectFill"
                                           SemanticProperties.Description="Cover image" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#8A7F8C"
                                           LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="6">
                                        <Border BackgroundColor="{Binding StatusColor}" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8" Padding="8,2">
                                            <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <Label Text="{Binding ProgressText}" FontSize="11" TextColor="#8A7F8C"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding NotesPreview}" FontSize="11" TextColor="#A0899C"
                                           IsVisible="{Binding HasNotes}" LineBreakMode="TailTruncation" />

                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"
                                          ColumnSpacing="5" RowSpacing="5">
                                        <Button Grid.Row="0" Grid.Column="0" Text="Consume"
                                                IsVisible="{Binding IsPlanned}" Clicked="OnConsumeClicked"
                                                CommandParameter="{Binding Id}" FontSize="10" Padding="4,2"
                                                MinimumHeightRequest="30" BackgroundColor="#B5D3B6" TextColor="#2D4A2E" />
                                        <Button Grid.Row="0" Grid.Column="1" Text="Rate"
                                                IsVisible="{Binding CanRate}" Clicked="OnRateClicked"
                                                CommandParameter="{Binding Id}" FontSize="10" Padding="4,2"
                                                MinimumHeightRequest="30" BackgroundColor="#D3B5C4" TextColor="#4A2E3E" />
                                        <Button Grid.Row="0" Grid.Column="2" Text="Reopen"
                                                IsVisible="{Binding CanReopen}" Clicked="OnReopenClicked"
                                                CommandParameter="{Binding Id}" FontSize="10" Padding="4,2"
                                                MinimumHeightRequest="30" BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
                                        <Button Grid.Row="1" Grid.Column="0" Text="Edit" Clicked="OnEditClicked"
                                                CommandParameter="{Binding Id}" FontSize="10" Padding="4,2"
                                                MinimumHeightRequest="30" BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
                                        <Button Grid.Row="1" Grid.Column="1" Text="Cover" Clicked="OnCoverClicked"
                                                CommandParameter="{Binding Id}" FontSize="10" Padding="4,2"
                                                MinimumHeightRequest="30" BackgroundColor="#EAE6DF" TextColor="#4A2E3E" />
                                        <Button Grid.Row="1" Grid.Column="2" Text="Delete" Clicked="OnDeleteClicked"
                                                CommandParameter="{Binding Id}" FontSize="10" Padding="4,2"
                                                MinimumHeightRequest="30" BackgroundColor="#C4A5A0" TextColor="#4A2E2A" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="5" x:Name="StatusLabel" FontSize="11" TextColor="#8A7F8C"
               LineBreakMode="TailTruncation" />
    </Grid>
</ContentPage>
