<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab3.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light=#F8F6F3, Dark=#121016}">

    <ScrollView Padding="16,12">
        <VerticalStackLayout Spacing="12">
            <Label Text="Settings" FontSize="25" FontAttributes="Bold" />

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1B24}" Stroke="{AppThemeBinding Light=#EAE6DF, Dark=#393343}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Appearance" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6B5B7A, Dark=#CDB9DB}" />
                    <Picker x:Name="ThemePicker" Title="Theme mode" SelectedIndexChanged="OnThemeChanged" />
                    <Label Text="Accent color" FontSize="12" TextColor="{AppThemeBinding Light=#8A7F8C, Dark=#B9AFBF}" />
                    <FlexLayout x:Name="AccentRow" Wrap="Wrap" JustifyContent="Start" AlignItems="Center" />
                    <Label Text="Theme mode follows the device unless you override it. The accent colors buttons and switches."
                           FontSize="11" TextColor="{AppThemeBinding Light=#8A7F8C, Dark=#B9AFBF}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1B24}" Stroke="{AppThemeBinding Light=#EAE6DF, Dark=#393343}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cover search engine" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6B5B7A, Dark=#CDB9DB}" />
                    <Picker x:Name="ProviderPicker" SelectedIndexChanged="OnProviderChanged" />
                    <Label Text="Auto routes by kind: Open Library for books, TVmaze for shows, Wikimedia for films and games."
                           FontSize="11" TextColor="{AppThemeBinding Light=#8A7F8C, Dark=#B9AFBF}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1B24}" Stroke="{AppThemeBinding Light=#EAE6DF, Dark=#393343}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Library location" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6B5B7A, Dark=#CDB9DB}" />
                    <Label x:Name="StorageLabel" FontSize="11" TextColor="{AppThemeBinding Light=#1A1525, Dark=#F4EEF7}" LineBreakMode="WordWrap" />

                    <Button Text="Move to app storage (private)" Clicked="OnAppStorageClicked" />
                    <Button x:Name="SharedButton" Text="Move to shared Documents" Clicked="OnSharedClicked" />

                    <Entry x:Name="CustomPathEntry" Placeholder="Custom folder, e.g. /storage/emulated/0/Notes/Watchlist" />
                    <Button Text="Move to custom folder" Clicked="OnCustomClicked" />

                    <Label Text="Moving copies your entries and covers. Files that already exist in the new folder are kept, and the old copy stays where it is. A custom or shared folder needs “All files access”."
                           FontSize="11" TextColor="{AppThemeBinding Light=#8A7F8C, Dark=#B9AFBF}" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="StatusLabel" FontSize="12" TextColor="{AppThemeBinding Light=#A0899C, Dark=#C9BDCF}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
